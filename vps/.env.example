# =============================================================================
# .env.example — Variabili d'ambiente per il deploy di Sogni d'Oro
#
# USO:
#   1. Copia questo file: cp .env.example .env
#   2. Modifica i valori reali in .env (NON committare .env su Git)
#   3. Proteggi il file: chmod 600 .env && chown APP_USER:APP_USER .env
#
# Il file .env viene caricato automaticamente dal systemd service tramite
# la direttiva EnvironmentFile=APP_DIR/.env
# =============================================================================


# --------------------------------------------------------------------------
# Configurazione server e percorsi
# --------------------------------------------------------------------------

# Directory di installazione dell'applicazione
APP_DIR=/var/www/sogni-doro

# Utente di sistema dedicato all'app (NON root)
APP_USER=sognidoro

# Porta su cui Streamlit risponde localmente (Nginx fa da proxy verso questa)
APP_PORT=8501

# --------------------------------------------------------------------------
# Dominio pubblico
# --------------------------------------------------------------------------

# Nome di dominio del sito (usato nella configurazione Nginx e nei certificati SSL)
DOMAIN_NAME=sognidoro.it

# --------------------------------------------------------------------------
# Repository GitHub
# --------------------------------------------------------------------------

# URL del repository da cui aggiornare il codice con update.sh
GITHUB_REPO=https://github.com/raffaelejband-svg/sogni-doro.git

# --------------------------------------------------------------------------
# Configurazione Streamlit (sovrascrivono i valori nel .service)
# --------------------------------------------------------------------------

# Avvia in modalita' headless (nessun browser automatico al boot)
STREAMLIT_SERVER_HEADLESS=true

# Porta di ascolto locale
STREAMLIT_SERVER_PORT=8501

# Indirizzo di ascolto: 127.0.0.1 espone solo a localhost (piu' sicuro)
# Cambia in 0.0.0.0 solo se Nginx NON e' configurato come reverse proxy
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# --------------------------------------------------------------------------
# Secrets applicazione (aggiungere qui le proprie chiavi)
# --------------------------------------------------------------------------

# Esempio: chiave API OpenAI (se usata dal chatbot)
# OPENAI_API_KEY=sk-...

# Esempio: percorso al vault Obsidian montato sul server
# OBSIDIAN_VAULT_PATH=/var/www/sogni-doro/vault

# Esempio: credenziali database (se aggiunte in futuro)
# DATABASE_URL=sqlite:///APP_DIR/data/smorfia.db
