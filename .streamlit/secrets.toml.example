# ──────────────────────────────────────────────────────────────────────────────
# SMORFIA — secrets.toml.example
#
# Copia questo file in .streamlit/secrets.toml e compila i valori.
# Il file secrets.toml NON deve mai essere committato su Git (già in .gitignore).
#
# Su Streamlit Community Cloud:
#   1. Vai su app.streamlit.io → la tua app → Settings → Secrets
#   2. Incolla il contenuto di questo file (con i valori reali)
# ──────────────────────────────────────────────────────────────────────────────

# URL della tua pagina Ko-fi per il pulsante "Offrimi un caffè"
# Esempio: "https://ko-fi.com/tuousername"
KOFI_URL = "https://ko-fi.com/TUO_USERNAME"

# Nome pubblico dell'app (apparirà nel titolo browser e nella sidebar)
APP_NAME = "SMORFIA — Il Sistema dei Sogni"

# Versione dell'app (opzionale, mostrata nel footer)
APP_VERSION = "1.0"
